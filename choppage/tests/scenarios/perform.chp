# The black keys while the break plays: beat repeats, reverse, tape stop, octave down, gate,
# scatter; a held slice taking over; patterns and breaks from the keyboard. Audio: perform.wav
wav perform.wav
wait 200
tap PLAY
wait 1200
# repeat 1/32 (A#3): the same half step over and over
key b2 down
wait 600
expect perf 4
expect repeat 1
shot repeat.png
key b2 up
wait 50
expect repeat 0
expect perf 0
# 1/16 then 1/64 on top: the last one held wins
key b1 down
wait 300
key b3 down
wait 300
expect perf 10
key b3 up
wait 200
expect perf 2
key b1 up
# reverse (F#4)
key b5 down
wait 400
expect perf 32
key b5 up
# tape stop (G#4): a beat to a halt
key b6 down
wait 500
shot tape.png
key b6 up
wait 200
# octave down, the gate, scatter
key b7 down
wait 300
key b7 up
key b9 down
wait 300
key b9 up
key b10 down
wait 800
expect perf 1024
key b10 up
wait 100
expect perf 0
# a slice held: it takes over, and the pattern comes back in time
key w12 down
wait 400
expect vslice >11
key w12 up
wait 600
expect playing 1
# OCT+: slices 17-32 on the keys
tap OCT+
expect kpage 1
key w0 down
wait 300
expect vslice >15
key w0 up
tap OCT-
expect kpage 0
# ENV + white key: a pattern (cued); LFO + white key: a break
press ENV
tapkey w2
release ENV
expect pat 2
expect cue 2
press LFO
tapkey w1
release LFO
expect brk 1
wait 2500
expect cur 2
shot perform-end.png
tap PLAY
wait 400
wavstop
